# Copy to .env.local and fill in. Never commit .env.local.

# --- Supabase (Project Settings → API). Region: Mumbai (ap-south-1).
NEXT_PUBLIC_SUPABASE_URL=https://your-project-ref.supabase.co
# The publishable (or legacy anon) key. Safe in the browser; RLS protects data.
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=
# The secret (or legacy service_role) key. Server only: bypasses RLS.
SUPABASE_SECRET_KEY=
# For `npx supabase link` / `db push`
SUPABASE_PROJECT_REF=
SUPABASE_DB_PASSWORD=

# --- App
NEXT_PUBLIC_SITE_URL=http://localhost:3000
# 32+ random characters. Signs the child-profile cookie.
STUDENT_SESSION_SECRET=
# Development only: show "Sign in as demo user" buttons on /login.
ENABLE_DEV_LOGIN=false
# Set to 1 to run tests/rls.test.ts against the Supabase project.
RUN_DB_TESTS=0

# --- Payments (Phase 1). Test mode keys only until the owner switches.
RAZORPAY_KEY_ID=
RAZORPAY_KEY_SECRET=
RAZORPAY_WEBHOOK_SECRET=

# --- Invoices. Confirm GST treatment with a CA before launch.
INVOICE_LEGAL_NAME="Offbook"
INVOICE_GSTIN=

# --- Email (Phase 1)
RESEND_API_KEY=
EMAIL_FROM="Offbook <hello@example.com>"

# --- Video (Phase 3). Test environment until launch.
MUX_TOKEN_ID=
MUX_TOKEN_SECRET=
MUX_WEBHOOK_SECRET=
MUX_SIGNING_KEY_ID=
MUX_SIGNING_KEY_PRIVATE=

# Weekly league rollover: send as "Authorization: Bearer <secret>" to /api/cron/league-rollover
CRON_SECRET=
